[Unit]
# DEPRECATED — do NOT enable this unit on production Jetson.
# The pip ctranslate2 wheel for aarch64 is CPU-only; enabling this unit
# occupies port 8095 and prevents the Docker container (which has the
# CUDA-compiled ctranslate2 from dustynv/faster-whisper) from binding.
#
# Canonical path: docker compose up -d adam-asr-whisperx
# adam_install_systemd.sh does NOT install or enable this unit.
#
# This file is kept as a reference / recovery fallback for environments
# where Docker is unavailable. To use it: manually copy to /etc/systemd/system/
# and make sure no Docker ASR container is running on port 8095.
Description=Adam Chip WhisperX ASR Service (native fallback; prefer Docker)
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=i17jet
Group=i17jet
SupplementaryGroups=render video
WorkingDirectory=/home/i17jet/Agents/Adam-Chip

# Refuse to start if Docker ASR container is already running — prevents CPU service
# from grabbing port 8095 and blocking the CUDA Docker container.
ExecStartPre=/bin/sh -c '! docker ps --format "{{.Names}}" 2>/dev/null | grep -q "^adam-asr-whisperx$$"'

Environment=PYTHONPATH=System
Environment=PATH=/home/i17jet/Agents/Adam-Chip/.venv/bin
Environment=ADAM_ASR_PORT=8095
Environment=ADAM_ASR_WHISPERX_MODEL=small
Environment=ADAM_ASR_LANGUAGE=ru
Environment=ADAM_ASR_DEVICE=cuda
Environment=ADAM_ASR_COMPUTE_TYPE=float16
# Silero VAD thresholds — lower onset/offset = more sensitive to brief/quiet speech.
# Restored from commit e390d16; default whisperx values (~0.5) miss short commands.
Environment=ADAM_ASR_VAD_ONSET=0.1
Environment=ADAM_ASR_VAD_OFFSET=0.2
# Per-segment logprob filter — segments below this are discarded as noise/hallucination.
# -1.7 accepts borderline uncertain segments (was hardcoded -0.8, which dropped ~1.5s clips).
Environment=ADAM_ASR_LOGPROB_THRESHOLD=-1.7
Environment=HF_HOME=/home/i17jet/Agents/Adam-Chip/data/hf_cache
ExecStart=/home/i17jet/Agents/Adam-Chip/.venv/bin/python -m Speech.ASR_WhisperX
Restart=always
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adam-asr-whisperx

# GPU access — Jetson Tegra requires nvmap + nvhost-* in addition to nvidia0/nvidiactl.
# DeviceAllow with any non-empty list blocks ALL unlisted devices (systemd cgroup policy),
# so we drop the restrictive list and rely on SupplementaryGroups=render video above,
# which already grants the necessary group-level access to /dev/nvmap and /dev/nvhost-*.
# DevicePolicy defaults to "auto": all devices accessible when DeviceAllow is empty.

[Install]
WantedBy=multi-user.target
