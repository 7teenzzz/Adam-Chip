  "services": {
    "startup_wait_for": "",
    "llm": {
      "provider": "openai",
      "base_url": "http://127.0.0.1:8081/v1",
      "model": "gemma-4-E4B-it-UD-Q4_K_XL",
      "timeout_sec": 60,
      "temperature": 0.7,
      "max_tokens": 40,
      "num_ctx": 8192,
      "model_path": "Subsystem/Models/gguf/gemma-4-E4B-it-UD-Q4_K_XL.gguf"
    },
    "vlm": {
      "base_url": "http://127.0.0.1:8051",
      "model": "Cosmos-Reason2-2B-Q8_0",
      "timeout_sec": 20,
      "max_new_tokens": 120,
      "prompt": "You are an eyes of cyborg. Look at the image and write ONE short English sentence describing what you actually see, using this structure:\nScene: <people count and position>. Engagement: <one of: none, watching, approaching, leaving, interacting>.\n\nReference examples (style only — do not copy):\n- Scene: 2 people near installation, one leaning in. Engagement: watching.\n- Scene: 1 person walking away from the camera. Engagement: leaving.\n- Scene: empty room. Engagement: none.\n\nOutput only the final sentence about this specific image. Never output placeholders like <people count and position> or angle-bracket tokens. English only."
    },
    "asr": {
      "provider": "whisperx",
      "base_url": "http://127.0.0.1:8095",
      "model": "small",
      "language": "ru",
      "listening_silence_timeout_sec": 6,
      "reply_window_sec": 3.75,
      "reply_silence_timeout_sec": 4,
      "post_tts_discard_window_ms": 300,
      "endpointing_debounce_frames": 5,
      "endpointing_voiced_debounce_frames": 3,
      "sample_rate": 16000,
      "timeout_sec": 30,
      "wake_words": "адам",
      "wake_word_required": true,
      "reply_window_expired_action": "standby",
      "pre_wake_buffer_ms": 1500,
      "silence_after_speech_ms": 1000,
      "silence_rms_threshold": 2100,
      "silence_keywords": [
        "стоп",
        "тихо",
        "замолчи",
        "хватит",
        "молчи"
      ],
      "disable_local_fallback": true,
      "esp_open_timeout_sec": 8,
      "esp_probe_after_fails": 2,
      "esp_retry_backoff_sec": [
        2,
        4,
        8,
        15
      ],
      "esp_stream_restart_after_fails": 5,
      "esp_stream_restart_cooldown_sec": 120.0,
      "logprob_threshold": -1.7,
      "vad_onset": 0.2,
      "vad_offset": 0.2,
      "asr_pre_send_min_rms": 200
    },
    "tts": {
      "provider": "silero",
      "base_url": "http://127.0.0.1:8082",
      "model": "v5_5_ru",
      "speaker": "eugene",
